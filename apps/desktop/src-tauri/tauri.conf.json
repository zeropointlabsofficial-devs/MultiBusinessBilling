{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Business Billing & Inventory",
  "version": "0.1.0",
  "identifier": "com.multibusiness.billing",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Business Billing & Inventory",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "shortDescription": "Billing and inventory management for multiple businesses",
    "category": "Business"
  }
}
