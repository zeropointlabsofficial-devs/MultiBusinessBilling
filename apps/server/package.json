{
  "name": "@billing/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "tsx test/require-disposable-database.ts",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "catalog:seed": "dotenv -e ../../.env -- tsx prisma/seed-catalog.ts",
    "bootstrap:admin": "dotenv -e ../../.env -- tsx prisma/bootstrap-admin.ts",
    "build:windows-installer": "powershell.exe -NoProfile -File scripts/windows/build-server-installer.ps1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.44.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/cors": "2.8.19",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "dotenv-cli": "8.0.0",
    "prisma": "7.10.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
